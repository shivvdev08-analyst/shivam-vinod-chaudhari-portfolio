# Copy to .env.local for local dev only. NEVER commit a real .env file.
# On Vercel, set these in Dashboard > Project > Settings > Environment Variables.
# No secrets are in this repo.

# Neon Postgres (free tier) — set automatically when you create a Neon
# database from Vercel Dashboard > Storage > Create Database > Neon.
# Format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Owner admin PIN, as a SHA-256 hex digest of the PIN Shivam chooses privately.
# Generate it locally (never paste the PIN or the hash in chat or in the repo):
#   node -e "console.log(require(crypto).createHash(sha256).update(YOUR-PIN-HERE).digest(hex))"
# Or use the in-browser hasher on /admin (the PIN never leaves the browser).
# 64 lowercase hex characters. The PIN itself is stored nowhere.
ADMIN_PIN_HASH=

# Vercel Blob (optional, for resume/photo uploads from /admin).
# Set automatically when you create a Blob store from Vercel Dashboard > Storage.
BLOB_READ_WRITE_TOKEN=
